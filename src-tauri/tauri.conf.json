{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StoryBook",
  "version": "0.0.1",
  "identifier": "com.storybook.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AI 小说编辑器",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "zzmzaizai",
    "shortDescription": "AI Novel Editor",
    "longDescription": "StoryBook is a cross-platform desktop application for AI-assisted novel writing",
    "category": "Productivity"
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/zzmzaizai/storybook/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJERjM4QjBDQjRBNkU3NjMKUldUa3dLZWJrU3V5ZHN4Z3lBcHZrQlBLU2d4a2h6eXl4Z3lBcHZrQlBLU2c9Cg=="
    }
  }
}
